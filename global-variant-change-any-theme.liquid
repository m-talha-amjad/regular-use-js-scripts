<style>
/* Variant Short Descriptions Styling */
  .phi--variant-descriptions {
    margin: 1rem 0;
  }
  
  .phi--variant-description {
    transition: opacity 0.3s ease, max-height 0.3s ease;
    overflow: hidden;
  }
  
  .phi--variant-description.phi--hidden {
    opacity: 0;
    max-height: 0;
    margin: 0;
    padding: 0;
  }
  
  .phi--variant-description-content {
    padding: 1rem;
    background-color: var(--color-body, #f8f8f8);
    border: 1px solid var(--g-input-border, #e0e0e0);
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-body-text, #333);
  }
  
  .phi--variant-description-content p {
    margin: 0;
  }
  
  .phi--variant-description-content p + p {
    margin-top: 0.5rem;
  }
</style>

<!-- Variant Short Descriptions -->
  <div class="phi--variant-descriptions mb-4">
    {% for variant in product.variants %}
      {% if variant.metafields.pic.short_description != blank %}
        <div class="phi--variant-description phi--variant-description-{{ variant.id }} {% unless variant == current_variant %}phi--hidden{% endunless %}" data-variant-id="{{ variant.id }}">
          <div class="phi--variant-description-content">
            {{ variant.metafields.pic.short_description | metafield_text }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

<script id="product-json" type="application/json">
{
  "options": [
    {% for option in product.options_with_values %}
    {
      "name": {{ option.name | json }},
      "position": {{ option.position }},
      "values": {{ option.values | json }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "variants": [
    {% for variant in product.variants %}
    {
      "id": {{ variant.id }},
      "title": {{ variant.title | json }},
      "options": {{ variant.options | json }},
      "description": {{ variant.metafields.pic.short_description | metafield_text | json }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
  const productJsonEl = document.getElementById("product-json");
  if (!productJsonEl) return;
  const productData = JSON.parse(productJsonEl.textContent);

  const optionInputs = document.querySelectorAll(".single-option-selector__radio");

  optionInputs.forEach(input => {
    input.addEventListener("change", handleVariantChange);
  });

  function handleVariantChange() {
    console.log("handleVariantChange");

    // Collect selected values based on data-index
    const selectedOptions = [];
    ["option1", "option2", "option3"].forEach((optKey, index) => {
      const checked = document.querySelector(`input[data-index="${optKey}"]:checked`);
      if (checked) {
        selectedOptions[index] = checked.value;
        console.log(`Selected ${optKey}:`, checked.value);
      }
    });

    // Find matching variant
    const matchedVariant = productData.variants.find(v =>
      v.options.every((optVal, i) => optVal === selectedOptions[i])
    );

    console.log("Matched Variant:", matchedVariant);

    if (matchedVariant) {
      document.querySelectorAll(".phi--variant-description").forEach(desc => {
        desc.classList.add("phi--hidden");
      });

      const targetDesc = document.querySelector(`.phi--variant-description-${matchedVariant.id}`);
      console.log("Target Description:", targetDesc);

      if (targetDesc) {
        targetDesc.classList.remove("phi--hidden");
      }
    }
  }
});
</script>
